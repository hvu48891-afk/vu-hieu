rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Classrooms collection: anyone can read monitoring stats, write allowed for authenticated users or in demo mode
    match /classrooms/{classroomId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // System settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
